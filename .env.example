# Meadlease (Koda) — plantilla de variables de entorno
# Copiar a `.env` y rellenar con credenciales reales. `.env` nunca se sube a git.

# --- LLM: proveedor primario (Groq) ---
# Agente (Pydantic AI) + STT (Whisper large-v3-turbo). Cadena de fallback: 3 modelos
# con la key principal -> los mismos 3 modelos con la key secundaria (ver ADR-013).
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=

# --- TTS: Azure Cognitive Services (voz es-PE-CamilaNeural) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Notificaciones: bot de Telegram ---
# El chat_id de cada cuidador vive en la BD (usuarios.chat_id), no aqui.
TELEGRAM_BOT_TOKEN=

# --- Rutas locales (opcional; hay valores por defecto en codigo) ---
# MEADLEASE_DB_PATH=database/meadlease.db
