# Meadlease (Koda) — plantilla de variables de entorno
# Copiar a `.env` y rellenar con credenciales reales. `.env` nunca se sube a git.

# --- LLM: proveedor primario (Groq) ---
# Agente (Pydantic AI) + STT (Whisper large-v3-turbo). Cadena de fallback: 3 modelos
# con la key principal -> 3 modelos con la key secundaria.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=

# --- LLM: benchmark exploratorio de proveedores alternativos (Fase 1) ---
# No forma parte de la cadena de fallback documentada (ver DECISIONES_TECNICAS.md
# ADR-013, solo-Groq). Se usa únicamente en scripts/benchmarks/llm/ para comparar
# antes de decidir si entra al diseño real. Cerebras y SambaNova se evaluaron y
# se descartaron: su "gratis" es un saldo fijo que se agota, no un tier gratuito
# perpetuo con límites por tasa/tiempo.
OPENROUTER_API_KEY=

# --- TTS: Azure Cognitive Services (voz es-PE-CamilaNeural) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Notificaciones: bot de Telegram ---
# El chat_id de cada cuidador vive en la BD (usuarios.chat_id), no aqui.
TELEGRAM_BOT_TOKEN=

# --- Rutas locales (opcional; hay valores por defecto en codigo) ---
# MEADLEASE_DB_PATH=database/meadlease.db
